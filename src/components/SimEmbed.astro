---
// The <rtos-sim> element with its static SVG, plus the loader that fetches the
// simulator bundle from /sim/ when the element comes near the viewport.
//
// The wrapper reserves the simulator's height here (not in the bundle's
// stylesheet, which loads late), so neither the bundle nor ads shift the page.
// Its id is stable on purpose: it is the selector for an "excluded area" in
// AdSense Auto ads. One simulator per page.
import manifest from '../generated/sim/manifest.json';

interface Props {
  scenario: string;
  rtos: string[];
  /** Id of the lesson the simulator belongs to: its diagram shows the lesson's key step. */
  lesson?: string;
}

const {scenario, rtos, lesson} = Astro.props;
const kernels: Record<string, {name: string; version: string}> = manifest.kernels;
const scenarios: Record<string, {title: string; simulated: string[]}> = manifest.scenarios;
const first = rtos[0];
const alt = `${scenarios[scenario].title} on ${kernels[first].name} ${kernels[first].version}`;
// A lesson whose scenario no model runs yet shows the much shorter placeholder.
// (Without a lesson the scenario can be switched, so the full height is kept.)
const placeholder = lesson !== undefined && !scenarios[scenario].simulated.includes(first);
const svg = lesson ? `lesson/${lesson}.${first}.svg` : `scenario/${scenario}.${first}.svg`;
---

<div id="rtos-sim-embed" class:list={['sim-embed', {'sim-embed-placeholder': placeholder}]}>
  <rtos-sim
    scenario={scenario}
    rtos={rtos.join(',')}
    data-js={`/sim/${manifest.bundle.js}`}
    data-css={`/sim/${manifest.bundle.css}`}
  >
    <img src={`/sim/svg/${svg}`} alt={alt} loading="lazy" decoding="async"/>
  </rtos-sim>
</div>
<noscript>
  <style>
    #rtos-sim-embed { min-height: 0; }
  </style>
</noscript>

<style>
  /* The heights of the simulator's layouts: panels stacked (phone, tablet) and
     side by side (from 1024px), measured with the tallest preset scenario. */
  .sim-embed {
    min-height: 1850px;
    margin: 2rem 0;
  }

  .sim-embed-placeholder {
    min-height: 700px;
  }

  @media (min-width: 640px) {
    .sim-embed {
      min-height: 1610px;
    }

    .sim-embed-placeholder {
      min-height: 420px;
    }
  }

  @media (min-width: 1024px) {
    .sim-embed {
      min-height: 790px;
    }

    .sim-embed-placeholder {
      min-height: 420px;
    }
  }

  .sim-embed img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }
</style>

<script>
  const elements = document.querySelectorAll<HTMLElement>('rtos-sim[data-js]');

  function load(el: HTMLElement) {
    const {js, css} = el.dataset;
    if (!js) return;
    // The bundle defines the <rtos-sim> custom element. If it fails to load,
    // the static SVG simply stays. It is added as a script tag, not with
    // import(): the Vite dev server rewrites a dynamic import to `<url>?import`
    // and then refuses to serve it, because files in public/ cannot be imported.
    const run = () => {
      if (document.querySelector(`script[src="${js}"]`)) return;
      const script = document.createElement('script');
      script.type = 'module';
      script.src = js;
      document.head.append(script);
    };
    if (!css || document.querySelector(`link[href="${css}"]`)) return run();
    // The stylesheet first, so the simulator never shows unstyled.
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = css;
    link.onload = run;
    link.onerror = run;
    document.head.append(link);
  }

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        load(entry.target as HTMLElement);
      }
    }, {rootMargin: '300px'});
    elements.forEach(el => observer.observe(el));
  } else {
    elements.forEach(load);
  }
</script>
