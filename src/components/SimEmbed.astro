---
// The <rtos-sim> element with its static SVG, plus the loader that fetches the
// simulator bundle from /sim/ when the element comes near the viewport.
//
// Step links in the page's text (`[tick 3](#sim:tick=3)`) are handled here too:
// a click scrolls the simulator into view and moves it to that step, loading
// the bundle first if needed. The address bar does not change.
//
// The wrapper reserves the simulator's height here (not in the bundle's
// stylesheet, which loads late), so neither the bundle nor ads shift the page.
// Its id is stable on purpose: it is the selector for an "excluded area" in
// AdSense Auto ads. One simulator per page.
import manifest from '../generated/sim/manifest.json';

interface Props {
  scenario: string;
  rtos: string[];
  /** Id of the lesson the simulator belongs to: its diagram shows the lesson's key step. */
  lesson?: string;
  /** Parameters the simulator opens with (a lesson's `params`). */
  params?: Record<string, string | number | boolean>;
}

const {scenario, rtos, lesson, params} = Astro.props;
const kernels: Record<string, {name: string; version: string}> = manifest.kernels;
const scenarios: Record<string, {title: string; simulated: string[]}> = manifest.scenarios;
const first = rtos[0];
const alt = `${scenarios[scenario].title} on ${kernels[first].name} ${kernels[first].version}`;
// A lesson whose scenario no model runs yet shows the much shorter placeholder.
// (Without a lesson the scenario can be switched, so the full height is kept.)
const placeholder = lesson !== undefined && !scenarios[scenario].simulated.includes(first);
const svg = lesson ? `lesson/${lesson}.${first}.svg` : `scenario/${scenario}.${first}.svg`;
---

<div id="rtos-sim-embed" class:list={['sim-embed', {'sim-embed-placeholder': placeholder}]}>
  <rtos-sim
    scenario={scenario}
    rtos={rtos.join(',')}
    params={params && Object.keys(params).length > 0 ? JSON.stringify(params) : undefined}
    data-js={`/sim/${manifest.bundle.js}`}
    data-css={`/sim/${manifest.bundle.css}`}
  >
    <img src={`/sim/svg/${svg}`} alt={alt} loading="lazy" decoding="async"/>
  </rtos-sim>
</div>
<noscript>
  <style>
    #rtos-sim-embed { min-height: 0; }
  </style>
</noscript>

<style>
  /* The heights of the simulator's layouts: tabs (phone), panels stacked
     (tablet) and side by side (from 1024px), measured with the tallest preset
     scenario on each kernel. */
  .sim-embed {
    min-height: 1280px;
    margin: 2rem 0;
    /* Below the site's sticky header when a step link scrolls to it. */
    scroll-margin-top: 5rem;
  }

  .sim-embed-placeholder {
    min-height: 700px;
  }

  /* The smallest phones: the parameters and controls wrap onto more rows. */
  @media (max-width: 359.98px) {
    .sim-embed:not(.sim-embed-placeholder) {
      min-height: 1350px;
    }
  }

  @media (min-width: 640px) {
    .sim-embed {
      min-height: 1740px;
    }

    .sim-embed-placeholder {
      min-height: 420px;
    }
  }

  @media (min-width: 1024px) {
    .sim-embed {
      min-height: 885px;
    }

    .sim-embed-placeholder {
      min-height: 420px;
    }
  }

  .sim-embed img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }
</style>

<script>
  const elements = document.querySelectorAll<HTMLElement>('rtos-sim[data-js]');

  function load(el: HTMLElement) {
    const {js, css} = el.dataset;
    if (!js) return;
    // The bundle defines the <rtos-sim> custom element. If it fails to load,
    // the static SVG simply stays. It is added as a script tag, not with
    // import(): the Vite dev server rewrites a dynamic import to `<url>?import`
    // and then refuses to serve it, because files in public/ cannot be imported.
    const run = () => {
      if (document.querySelector(`script[src="${js}"]`)) return;
      const script = document.createElement('script');
      script.type = 'module';
      script.src = js;
      document.head.append(script);
    };
    if (!css || document.querySelector(`link[href="${css}"]`)) return run();
    // The stylesheet first, so the simulator never shows unstyled.
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = css;
    link.onload = run;
    link.onerror = run;
    document.head.append(link);
  }

  // Step links: `<a href="#sim:…">` anywhere on the page moves the page's simulator.
  document.addEventListener('click', (e) => {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const link = (e.target as Element | null)?.closest?.('a[href^="#sim:"]');
    const el = elements[0];
    if (!link || !el) return;
    e.preventDefault();
    const href = link.getAttribute('href') as string;
    const embed = el.closest('.sim-embed') ?? el;
    const top = embed.getBoundingClientRect().top;
    const margin = parseFloat(getComputedStyle(embed).scrollMarginTop) || 0;
    // Scroll unless the simulator's top is already in the upper part of the screen.
    if (top < margin - 2 || top > margin + window.innerHeight / 4) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      embed.scrollIntoView({behavior: reduce ? 'auto' : 'smooth', block: 'start'});
    }
    if (customElements.get('rtos-sim')) {
      el.dispatchEvent(new CustomEvent('rtos-sim-goto', {detail: href}));
    } else {
      // The bundle reads this when it starts.
      el.dataset.goto = href;
      load(el);
    }
  });

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        load(entry.target as HTMLElement);
      }
    }, {rootMargin: '300px'});
    elements.forEach(el => observer.observe(el));
  } else {
    elements.forEach(load);
  }
</script>
