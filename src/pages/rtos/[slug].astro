---
import {getCollection, render} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import MetadataDisplay from '../../components/MetadataDisplay.astro';
import ProjectsList from '../../components/ProjectsList.astro';
import {KERNEL_SECTIONS, sectionOf, sortLessons} from '../../collections/lesson-nav';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const rtos = await getCollection('rtos');
  return rtos.map(entry => ({
    params: {slug: entry.data.slug},
    props: {entry},
  }));
}

const {entry} = Astro.props;
const {Content} = await render(entry);

// Find related projects (order by isShow first, then by creation time)
const allProjects = await getCollection('projects');
const relatedProjects = allProjects
  .filter(p => p.data.rtos === entry.data.slug)
  .sort((a, b) => {
    return b.data.createdAt.valueOf() - a.data.createdAt.valueOf();
  });
const displayedProjects = relatedProjects.slice(0, 8); // Show first 9 projects

// The walkthroughs of this kernel's source under /learn/ (for the kernels the simulator models).
const walkthroughs = KERNEL_SECTIONS.includes(entry.data.slug)
  ? sortLessons((await getCollection('lessons')).filter(l => sectionOf(l.id).id === entry.data.slug))
  : [];
---

<Layout title={`${entry.data.title} - Open Source RTOS`} description={entry.data.summary}>
  <article class="max-w-full">
    <div class="flex items-center gap-4 mb-8 flex-wrap">
      <h1 class="text-4xl md:text-5xl font-extrabold m-0 text-gray-800 dark:text-gray-200">
        {entry.data.title}
      </h1>
      {entry.data.version && (
         <span
            class="bg-secondary-100 dark:bg-secondary-900/30 text-secondary-800 dark:text-secondary-400 px-4 py-2 rounded-lg text-sm font-semibold font-mono">
					{entry.data.version}
				</span>
      )}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_350px] gap-8 lg:gap-12 mb-16">
      <div class="min-w-0">
        <div class="prose mb-3">
          {entry.data.summary}
        </div>

        {entry.data.image && (
           <img src={entry.data.image} alt={entry.data.title} class="w-full h-auto rounded-lg mb-8 shadow-md"/>
        )}

        <div class="prose">
          <Content/>
        </div>
      </div>

      <aside class="lg:order-0 order-first">
        <MetadataDisplay
           star={entry.data.star}
           lastUpdated={entry.data.lastUpdated}
           version={entry.data.version}
           components={entry.data.components}
           licenses={entry.data.licenses}
           platforms={entry.data.platforms}
           codeUrl={entry.data.codeUrl}
           siteUrl={entry.data.siteUrl}
        />
      </aside>
    </div>

    {walkthroughs.length > 0 && (
       <section id="learn" class="mt-16 pt-12 border-t-2 border-gray-200 dark:border-gray-700 scroll-mt-24">
         <div class="flex items-center justify-between mb-2">
           <h2 class="text-3xl font-bold m-0 text-gray-800 dark:text-gray-100">
             Learn how {entry.data.title} works
           </h2>
           <a href={`/learn/#${entry.data.slug}`}
              class="text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 no-underline font-semibold text-base transition-colors">
             All Lessons →
           </a>
         </div>
         <p class="text-gray-600 dark:text-gray-400 m-0 mb-6">
           Step through the {entry.data.title} kernel line by line in an interactive simulator, next to its source code.
           New to real-time kernels? <a href="/learn/" class="text-primary-600 dark:text-primary-400 underline">Start with the basics</a>.
         </p>
         <ul class="list-none p-0 m-0 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
           {walkthroughs.map(lesson => (
             <li>
               <a href={`/learn/${lesson.id}/`}
                  class="block h-full rounded-lg border border-gray-200 dark:border-gray-700 p-4 no-underline hover:border-primary-500 transition-colors">
                 <span class="block font-semibold text-primary-600 dark:text-primary-400">{lesson.data.title}</span>
                 <span class="block mt-1 text-sm text-gray-600 dark:text-gray-400">{lesson.data.description}</span>
               </a>
             </li>
           ))}
         </ul>
       </section>
    )}

    {relatedProjects.length > 0 && (
       <section class="mt-16 pt-12 border-t-2 border-gray-200 dark:border-gray-700">
         <div class="flex items-center justify-between mb-8">
           <h2 class="text-3xl font-bold m-0 text-gray-800 dark:text-gray-100">
             Related Projects
           </h2>
           {relatedProjects.length > 8 && (
             <a href={`/projects/${entry.data.slug}/`}
                class="text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 no-underline font-semibold text-base transition-colors">
               View All Projects →
             </a>
           )}
         </div>
         <ProjectsList projects={displayedProjects} isHorizontal={true} />
         {relatedProjects.length > 8 && (
           <div class="text-center mt-8">
             <a href={`/projects/${entry.data.slug}/`}
                class="inline-block px-6 py-3 bg-gray-100 dark:bg-gray-700 text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 no-underline rounded-lg font-semibold transition-colors hover:bg-grey-700 dark:hover:bg-grey-600">
               View All Projects
             </a>
           </div>
         )}
       </section>
    )}
  </article>
</Layout>
