---
import {getCollection, render} from 'astro:content';
import LessonLayout from '../../layouts/LessonLayout.astro';
import manifest from '../../generated/sim/manifest.json';
import {RESERVED, neighbours, sectionOf} from '../../collections/lesson-nav';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map(entry => {
    if (RESERVED.includes(entry.id)) {
      throw new Error(`Lesson "${entry.id}.md": "${entry.id}" is reserved under /learn/ and cannot be a lesson slug.`);
    }
    const {prev, next} = neighbours(lessons, entry.id);
    const link = (l?: typeof entry) => l && {href: `/learn/${l.id}/`, title: l.data.title};
    return {params: {slug: entry.id}, props: {entry, prev: link(prev), next: link(next)}};
  });
}

const {entry, prev, next} = Astro.props;

// Step links in the text: `](#sim:…)`, each once, in order (the export finds them the same way).
const links = [...new Set([...(entry.body ?? '').matchAll(/\]\((#sim:[^)\s]*)\)/g)].map(m => m[1]))];
if (links.length > 0 && !entry.data.scenario) {
  throw new Error(`Lesson "${entry.id}.md": step links (#sim:…) need a scenario.`);
}

// The simulator export drew this lesson's diagram from its scenario, rtos,
// keyStep and params, and checked its step links against the run. If any of
// them has changed since, the diagram is stale or a link is unchecked.
if (entry.data.scenario) {
  type Exported = {scenario: string; rtos: string[]; keyStep?: {event: string; nth: number}; params?: Record<string, unknown>; links?: string[]};
  const exported: Record<string, Exported> = manifest.lessons;
  const was = exported[entry.id];
  const params = (p?: Record<string, unknown>) => JSON.stringify(Object.entries(p ?? {}).sort(([a], [b]) => a.localeCompare(b)));
  const same = was
    && was.scenario === entry.data.scenario
    && JSON.stringify(was.rtos) === JSON.stringify(entry.data.rtos)
    && was.keyStep?.event === entry.data.keyStep?.event
    && was.keyStep?.nth === entry.data.keyStep?.nth
    && params(was.params) === params(entry.data.params)
    && JSON.stringify(was.links ?? []) === JSON.stringify(links);
  if (!same) {
    throw new Error(
      `Lesson "${entry.id}.md": scenario, rtos, keyStep, params or step links changed since the simulator export (or the lesson is new). ` +
      'Run `pnpm export:site` in the simulator repository and commit the result.',
    );
  }
}
const {Content} = await render(entry);
const section = sectionOf(entry.id);
---

<LessonLayout
  title={entry.data.title}
  description={entry.data.description}
  lesson={entry.id}
  scenario={entry.data.scenario}
  rtos={entry.data.rtos}
  params={entry.data.params}
  section={section.id ? section.title : undefined}
  prev={prev}
  next={next}
>
  <Content/>
</LessonLayout>
