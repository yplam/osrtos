---
// Every preset scenario in one simulator. The scenario is chosen with the
// select (or ?scenario=<id>); its parameters are changed inside the simulator,
// which also reads a link to a step (?rtos, ?step, ?p.<parameter>).
import Layout from '../../layouts/Layout.astro';
import SimEmbed from '../../components/SimEmbed.astro';
import manifest from '../../generated/sim/manifest.json';
import {feedbackUrl} from '../../collections/lesson-nav';

const scenarios = Object.entries(manifest.scenarios)
  .map(([id, s]) => ({id, title: s.title, rtos: s.rtos, simulated: s.simulated}))
  // Scenarios that no kernel model runs yet come last.
  .sort((a, b) => Number(b.simulated.length > 0) - Number(a.simulated.length > 0));
// A kernel without a model for the scenario shows a placeholder, so models come first.
const order = (s: (typeof scenarios)[number]) =>
  [...s.rtos].sort((a, b) => Number(s.simulated.includes(b)) - Number(s.simulated.includes(a)));
const first = scenarios[0];
const kernels: Record<string, {name: string; version: string}> = manifest.kernels;
const feedback = feedbackUrl(new URL('/learn/playground/', Astro.site).href, 'Scheduler playground', manifest);
---

<Layout
  title="RTOS scheduler playground - OSRTOS"
  description="Run preset RTOS scheduling scenarios step by step on line-by-line models of the FreeRTOS and Zephyr kernels, next to their source code, and change the parameters."
>
  <header>
    <nav aria-label="Breadcrumb" class="text-sm text-gray-500 dark:text-gray-400 mb-4">
      <a href="/learn/" class="text-indigo-600 dark:text-indigo-400 no-underline hover:underline">Learn</a>
      <span aria-hidden="true" class="mx-1">/</span>
    </nav>
    <h1 class="text-3xl md:text-4xl font-extrabold m-0 mb-4 text-gray-800 dark:text-gray-200">Scheduler playground</h1>
    <p class="text-lg text-gray-600 dark:text-gray-300 m-0 mb-6">
      Pick a scenario, step through what the kernel does on every tick, and change the parameters to see what happens.
    </p>
    <label class="flex flex-wrap items-center gap-2 text-gray-700 dark:text-gray-300 font-medium">
      Scenario
      <select id="playground-scenario" class="max-w-full rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-2 py-1 font-normal">
        {scenarios.map(s => (
          <option value={s.id} data-rtos={order(s).join(',')} data-svg={`/sim/svg/scenario/${s.id}.${order(s)[0]}.svg`} data-alt={`${s.title} on ${kernels[order(s)[0]].name} ${kernels[order(s)[0]].version}`}>
            {s.title}{s.simulated.length === 0 ? ' (not simulated yet)' : ''}
          </option>
        ))}
      </select>
    </label>
  </header>

  <SimEmbed scenario={first.id} rtos={order(first)}/>

  <p class="text-sm text-gray-500 dark:text-gray-400">
    The simulator runs a line-by-line model of the kernel, checked against the real kernel.{' '}
    <a href="/learn/licenses/" class="text-indigo-600 dark:text-indigo-400 underline">Source and licenses</a>.{' '}
    Does it show something a real kernel does not do?{' '}
    <a href={feedback} rel="noopener" class="text-indigo-600 dark:text-indigo-400 underline">Tell us in a GitHub issue</a>.
  </p>
</Layout>

<script>
  const select = document.querySelector<HTMLSelectElement>('#playground-scenario');
  const sim = document.querySelector<HTMLElement>('#rtos-sim-embed rtos-sim');

  function show(id: string, updateUrl: boolean) {
    if (!select || !sim) return;
    const option = [...select.options].find(o => o.value === id);
    if (!option) return;
    select.value = id;
    sim.setAttribute('scenario', id);
    sim.setAttribute('rtos', option.dataset.rtos ?? '');
    const img = sim.querySelector('img');
    if (img && option.dataset.svg) {
      img.src = option.dataset.svg;
      img.alt = option.dataset.alt ?? '';
    }
    if (updateUrl) {
      const url = new URL(location.href);
      // A link to a step of another scenario (?rtos, ?step, ?p.<parameter>) no longer applies.
      for (const key of [...url.searchParams.keys()]) {
        if (key === 'rtos' || key === 'step' || key.startsWith('p.')) url.searchParams.delete(key);
      }
      url.searchParams.set('scenario', id);
      history.replaceState(null, '', url);
    }
  }

  const wanted = new URLSearchParams(location.search).get('scenario');
  if (wanted) show(wanted, false);
  select?.addEventListener('change', () => show(select.value, true));
</script>
